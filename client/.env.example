# =============================================================================
# Inceptrix / VitalTwin — environment variables
# Copy to .env.local and fill in values. Never commit .env.local.
# =============================================================================

# --- Report API (LLM / predict) ---
# Full URL to the predict endpoint. Required for generating health reports.
REPORT_API_URL=https://your-ngrok-or-api.example.com/predict
# Optional: same URL exposed to client (e.g. for direct calls). Usually leave unset.
# NEXT_PUBLIC_REPORT_API_URL=

# Optional: custom path for predict (default /predict). Rarely needed.
# REPORT_API_PREDICT_PATH=predict

# --- What-if ---
# Option A: Dedicated what-if backend URL. If set, what-if requests go here.
# Option B: Leave unset and set OPENROUTER_API_KEY — what-if uses OpenRouter AI with full context (inputs + report).
# REPORT_API_WHATIF_URL=https://your-api.example.com/what-if

# Optional: custom path for what-if on same host as report API (default /what-if).
# REPORT_API_WHATIF_PATH=what-if

# --- OpenRouter AI (what-if section) ---
# When set, what-if section uses OpenRouter to generate "if you reduce X, gain Y years and Z points" and recommendations.
# Get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OpenRouter model for what-if (default: Gemini). Examples: google/gemini-2.0-flash-exp, google/gemini-flash-1.5
OPENROUTER_WHATIF_MODEL=google/gemini-2.0-flash-exp

# --- Profile / submissions API ---
# Base URL for saving and loading profile + health input. Default: https://vitaltwin-backend.onrender.com
# PROFILE_API_URL=https://vitaltwin-backend.onrender.com
# NEXT_PUBLIC_PROFILE_API_URL=

# Path: "profile" or "submissions" (default profile).
# PROFILE_API_PATH=profile

# --- App URL (optional) ---
# Used as HTTP-Referer for OpenRouter. Default: http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000
