# ================================
# client/.gitignore - Next.js Frontend
# ================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
/.next/
/out/
/build

# Testing
/coverage
.nyc_output

# Environment files — NEVER commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
nextjs_log.txt
nextjs_err.txt
*.log

# Misc
.DS_Store
Thumbs.db
*.pem

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Claude AI context
.claude/
