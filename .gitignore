# ================================
# Root .gitignore - VitalTwin
# ================================

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Build output logs
build_output.txt

# Environment files
.env
.env.local
.env.*.local
*.pem

# Logs
*.log
logs/

# Claude AI context (not needed in repo)
.claude/

# Ignore both subfolders' specific artifacts (handled in their own .gitignore)
client/node_modules/
client/.next/
model/__pycache__/
model/*.pyc
